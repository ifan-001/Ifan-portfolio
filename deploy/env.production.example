APP_NAME="Hasnain Portfolio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Dhaka
APP_URL=https://YOUR-DOMAIN

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Filled in automatically by deploy/server-setup.sh (see ~/.portfolio_db_pass)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portfolio
DB_USERNAME=portfolio
DB_PASSWORD=CHANGE_ME
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
CACHE_PREFIX=

# Contact-form e-mail. "log" only writes to the log (inquiries are always saved in the
# admin inbox). To get e-mails, use Gmail SMTP with an App Password:
#   MAIL_MAILER=smtp  MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  MAIL_ENCRYPTION=tls
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@YOUR-DOMAIN"
MAIL_FROM_NAME="${APP_NAME}"

# Only used if you ever seed a brand-new admin (php artisan db:seed). Not needed after the data import.
ADMIN_INITIAL_PASSWORD=

# Leave empty: nginx talks to PHP directly. Set only if you put Cloudflare proxy in front.
TRUSTED_PROXIES=
